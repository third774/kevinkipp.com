{
  "name": "kevinkipp.com",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "wrangler types && astro dev --open",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply kevinkipp.com --local",
    "db:migrate:prod": "wrangler d1 migrations apply kevinkipp.com --remote",
    "db:migrate:preview": "wrangler d1 migrations apply --env preview kevinkipp.com_preview --remote",
    "db:studio:local": "LOCAL_DB_PATH=$(find .wrangler/state/v3/d1/miniflare-D1DatabaseObject -type f -name '*.sqlite' -print -quit) drizzle-kit studio",
    "db:studio:preview": "source .drizzle.env && DB_ID='167258f1-9e95-4b98-80fd-df0f4e81112b' drizzle-kit studio",
    "db:studio:prod": "source .drizzle.env && DB_ID='d5c17b3d-78fb-4894-a743-95b19cac53a9' drizzle-kit studio",
    "start": "wrangler types && astro dev",
    "build": "wrangler types && VITE_COMMIT_HASH=\"$(git rev-parse --short HEAD)\" astro build",
    "newpost": "node ./scripts/newpost.js",
    "preview": "wrangler types && astro preview",
    "prepare": "astro sync",
    "astro": "astro",
    "prettier": "prettier --write .",
    "upgrade": "pnpm run upgrade:astro && pnpm run upgrade:others",
    "upgrade:astro": "pnpm dlx @astrojs/upgrade",
    "upgrade:others": "pnpm dlx npm-upgrade",
    "types": "wrangler types",
    "typecheck": "astro sync && tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.4",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@daviddarnes/share-button": "^1.1.3",
    "@evilmartians/harmony": "^1.4.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/sanitize-html": "^2.16.0",
    "astro": "^7.4.5",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^5.9.3",
    "marked": "^15.0.12",
    "sanitize-html": "^2.17.0",
    "tailwind-merge": "^2.5.3",
    "tailwindcss": "^4.3.4",
    "tiny-invariant": "^1.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "@csstools/postcss-oklab-function": "^4.0.10",
    "better-sqlite3": "^11.10.0",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-organize-imports": "^4.1.0",
    "wrangler": "^4.143.0"
  },
  "packageManager": "pnpm@12.16.1"
}
